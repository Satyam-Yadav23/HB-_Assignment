{
  "expo": {
    "name": "HB Plus Auth",
    "slug": "hbplus-auth",
    "scheme": "hbplusauth",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      "expo-router",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "name": "HB Plus Auth",
      "shortName": "HB Plus",
      "themeColor": "#102a43",
      "backgroundColor": "#f4f7fb"
    },
    "ios": {
      "bundleIdentifier": "fit.hbplus.auth"
    },
    "android": {
      "package": "fit.hbplus.auth"
    }
  }
}
